<Project>
  <!--
    Centralized package version management.
    All PackageReference versions in *.csproj derive from here.
    To update a package, change the version here and it applies everywhere.
  -->
  <ItemGroup>
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting" Version="13.3.5" />

    <!-- Azure Provisioning -->
    <PackageVersion Include="Azure.Provisioning" Version="1.0.0" />
    <PackageVersion Include="Azure.Provisioning.Redis" Version="1.0.0" />
    <PackageVersion Include="Azure.Provisioning.Storage" Version="1.0.0" />
    <PackageVersion Include="Azure.Provisioning.Sql" Version="1.0.0" />

    <!-- Open XML SDK -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />

    <!-- Testing -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="xunit.analyzers" Version="1.20.0" />
  </ItemGroup>
</Project>
