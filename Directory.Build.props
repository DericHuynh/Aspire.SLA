<Project>
  <!--
    Solution-wide build configuration — applies to every project.
    Strictest settings: all analyzers on, warnings as errors, full nullability.
  -->
  <PropertyGroup>
    <!-- Language Standards & Safety -->
    <LangVersion>latest</LangVersion>
    <!-- Crucial: Enabler for the CS86xx / CS87xx nullable warnings listed below -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Instructs the compiler to use strict rules for language features -->
    <Features>strict</Features>

    <!-- Strict analysis: enable all rules -->
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- "latest-all" ensures every single analyzer category is strictly evaluated -->
    <AnalysisLevel>latest-all</AnalysisLevel>

    <!-- Treat warnings as errors (or as warnings during development — uncomment to switch) -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Explicitly elevates all nullable warnings to errors.
         Adding "Nullable" as a catch-all, alongside your precise warning list.
         These remain errors even if TreatWarningsAsErrors is toggled off locally. -->
    <WarningsAsErrors>$(WarningsAsErrors);Nullable;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8609;CS8610;CS8611;CS8612;CS8613;CS8614;CS8615;CS8616;CS8617;CS8618;CS8619;CS8620;CS8621;CS8622;CS8624;CS8625;CS8629;CS8631;CS8633;CS8634;CS8643;CS8644;CS8645;CS8653;CS8654;CS8655;CS8667;CS8669;CS8670;CS8714;CS8762;CS8763;CS8764;CS8765;CS8766;CS8767;CS8768;CS8769;CS8770;CS8772;CS8773;CS8774;CS8775;CS8776;CS8777;CS8778;CS8779;CS8780;CS8784;CS8785;CS8794;CS8795;CS8819;CS8824;CS8825;CS8847;CS8848;CS8936</WarningsAsErrors>

    <!-- Ensures Roslyn Analyzer warnings also fail the build under TreatWarningsAsErrors -->
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>

    <!-- Enforces XML documentation on all public members (triggers CS1591 if missing) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Centralized package management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- IDE analyzers in build -->
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    <!-- Outputs diagnostic performance details for analyzers to spot slow rules -->
    <ReportAnalyzer>true</ReportAnalyzer>

    <!-- Build Safety, Reliability & Performance -->
    <!-- Forces reproducible builds across different machines -->
    <Deterministic>true</Deterministic>
    <!-- Throws OverflowExceptions on integer arithmetic overflow/underflow (slight overhead, high safety) -->
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <!-- Optimizes build speed inside IDEs for fast feedback loops -->
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>
</Project>
